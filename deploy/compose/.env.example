# Copy to .env and adjust. These are LOCAL DEFAULTS; never commit real secrets.
# docker compose reads this automatically.

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-locally

# Postgres (Iceberg REST catalog backing store)
POSTGRES_PASSWORD=change-me-locally

# Gateway load generator
ML_EVENTS_PER_SEC=5000
ML_SCHEMA_VERSION=1
